// SPDX-License-Identifier: GPL-3.0-or-later
// One Worker for the whole product (ADR-0003). M3: static assets only (web/dist); the
// allowlisted /proxy route (ADR-0002) is added in M5 with `main` and `run_worker_first`.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "app",
  "compatibility_date": "2026-10-29",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "../web/dist"
  }
}
